---
import { env } from "cloudflare:workers";
import { ChevronRightIcon } from "@heroicons/react/24/outline";
import Layout from "../../layouts/Layout.astro";
import Button from "../../ui/button.astro";
import Breadcrumbs from "../../ui/breadcrumbs.astro";
import LibraryCollectionCard from "../../ui/library-collection-card.astro";
import { getAuth, getPageSession } from "../../lib/auth";
import { createLibraryStore } from "../../lib/library-store";

export const prerender = false;

const auth = getAuth(env);
if (!auth) return Astro.redirect("/login");
const session = await getPageSession(
  auth,
  Astro.request.headers,
  Astro.response.headers,
);
if (!session) return Astro.redirect("/login");
const library = env.AUTH_DB
  ? await createLibraryStore(env.AUTH_DB).snapshot(session.user.id)
  : null;
const name = session.user.name || session.user.email;
const initial = name.trim().charAt(0).toUpperCase() || "?";
const avatarUrl = session.user.image ?? null;
---

<Layout
  title="Account | UI Skills"
  description="Manage your UI Skills account."
  robots="noindex,nofollow"
  showNewsletter={false}
>
  <div class="container-3xl pt-20 pb-10">
    <div class="flex flex-col gap-10">
      <Breadcrumbs
        items={[{ label: "Explore", href: "/" }, { label: "Account" }]}
      />

      <div class="flex flex-col gap-6">
        <h1 class="type-h1 text-content-primary">Account</h1>
        <div class="flex items-center gap-4">
          {
            avatarUrl ? (
              <img
                src={avatarUrl}
                alt=""
                width="48"
                height="48"
                class="border-line-default size-12 shrink-0 rounded-full border"
              />
            ) : (
              <span
                aria-hidden="true"
                class="border-line-default bg-surface-subtle text-content-secondary type-body-md inline-flex size-12 shrink-0 items-center justify-center rounded-full border font-[450]"
              >
                {initial}
              </span>
            )
          }
          <div class="flex min-w-0 flex-col gap-0.5">
            <p class="type-body-md text-content-primary truncate font-[450]">
              {name}
            </p>
            <p class="type-body-md text-content-secondary truncate">
              {session.user.email}
            </p>
          </div>
        </div>
      </div>

      <section class="flex flex-col gap-4" aria-labelledby="library-title">
        <div class="flex items-center justify-between gap-4">
          <h2
            id="library-title"
            class="text-content-primary text-lg font-medium tracking-tight"
          >
            Library
          </h2>
          <a
            href="/library"
            class="type-body-md text-content-secondary hover:text-content-primary focus-visible:outline-content-primary inline-flex items-center gap-1 rounded-md focus-visible:outline-1 focus-visible:outline-offset-2"
          >
            Open library
            <ChevronRightIcon className="size-4" aria-hidden="true" />
          </a>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <LibraryCollectionCard
            href="/library"
            title="Favorites"
            icon="star"
            skillPaths={library?.savedSkillPaths ?? []}
          />
          {
            library?.collections.map((collection) => (
              <LibraryCollectionCard
                href={`/library/${collection.slug}`}
                title={collection.title}
                collectionId={collection.id}
                skillPaths={collection.skillPaths}
              />
            ))
          }
        </div>
      </section>

      <div data-account-actions>
        <Button variant="secondary" data-sign-out>Sign out</Button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { authClient } from "../../lib/auth-client";
  import { bindAuthActions } from "../../lib/auth-actions";

  const actions = document.querySelector<HTMLElement>("[data-account-actions]");
  bindAuthActions(
    actions,
    async (button) => {
      if (!button.hasAttribute("data-sign-out")) return;
      const result = await authClient.signOut();
      if (result.error) throw new Error("Sign-out failed");
      window.location.assign("/");
    },
    "That action could not be completed. Please try again.",
  );
</script>
