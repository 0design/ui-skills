---
import { StarIcon, XMarkIcon } from "@heroicons/react/24/solid";
import SkillCard from "./skill-card.astro";
import type { LibrarySkillView } from "../lib/library-view";

type Props = {
  skill: LibrarySkillView;
  /** `star` unsaves a favorite; `remove` takes the skill out of a collection. */
  action: "star" | "remove";
  label: string;
  /** Data attributes that wire the button to the library client. */
  actionAttrs: Record<string, string>;
};

const { skill, action, label, actionAttrs } = Astro.props as Props;
---

<div class="flex items-center gap-3">
  <div class="min-w-0 flex-1">
    {
      skill.available ? (
        <SkillCard
          href={skill.href}
          slug={skill.slug}
          description={skill.description}
          ownerLabel={skill.ownerLabel}
          avatarUrl={skill.avatarUrl}
          variant="list"
        />
      ) : (
        <div class="border-line-default flex flex-col gap-0.5 border-b pt-3 pb-4">
          <p class="type-body-md text-content-primary font-[450]">
            {skill.name}
          </p>
          <p class="type-body-md text-content-secondary">
            This skill is no longer in the directory.
          </p>
        </div>
      )
    }
  </div>
  <button
    type="button"
    aria-label={label}
    title={label}
    class="text-content-secondary hover:bg-fill-strong hover:text-content-primary focus-visible:outline-content-primary inline-flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-lg transition-colors focus-visible:outline-1 focus-visible:outline-offset-2 disabled:opacity-60"
    {...actionAttrs}
  >
    {
      action === "star" ? (
        <StarIcon className="text-content-primary size-4" aria-hidden="true" />
      ) : (
        <XMarkIcon className="size-4" aria-hidden="true" />
      )
    }
  </button>
</div>
