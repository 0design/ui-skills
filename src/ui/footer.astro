---
import { topicBySlug } from "../data/topics";
import type { TopicSlug } from "../data/registry";
import { agents } from "../data/agents";
import { playbook } from "../data/playbook";
import { collections } from "../data/collections";
import { skills } from "../data/skills";

const currentYear = new Date().getFullYear();
const footerTopicSlugs: TopicSlug[] = [
  "accessibility",
  "motion",
  "systems",
  "visual",
  "interaction",
  "performance",
  "craft",
  "typography",
  "frontend",
  "frameworks",
  "shadcn-ui-development",
  "testing",
];
const featuredTopics = footerTopicSlugs
  .map((slug) => topicBySlug.get(slug))
  .filter((topic): topic is NonNullable<typeof topic> => Boolean(topic));
const featuredAgentIds = [
  "claude-code",
  "cursor",
  "openclaw",
  "codex",
  "github-copilot",
  "opencode",
  "gemini",
  "windsurf",
  "cline",
  "antigravity",
  "amp",
  "zed",
];
const featuredAgents = featuredAgentIds
  .map((id) => agents.find((agent) => agent.id === id))
  .filter((agent): agent is NonNullable<typeof agent> => Boolean(agent));
const footerPlaybookSlugs = [
  "reserve-space-with-aspect-ratio",
  "use-text-balance",
  "use-tabular-nums-for-data",
  "use-large-touch-targets",
  "use-concentric-border-radius",
  "add-scale-on-press",
  "show-visible-focus-rings",
  "label-every-form-field",
  "show-errors-beside-fields",
  "use-structural-skeletons",
  "give-empty-states-one-action",
  "use-interruptible-transitions",
];
const playbookBySlug = new Map(playbook.map((entry) => [entry.slug, entry]));
const featuredPlaybook = footerPlaybookSlugs
  .map((slug) => playbookBySlug.get(slug))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));
const footerSkillPaths = [
  "ibelick/ui-skills-root",
  "ibelick/improve-ui",
  "ibelick/create-design-md",
  "nextlevelbuilder/ui-ux-pro-max",
  "0xdesign/design-lab",
  "emilkowalski/improve-animations",
  "jakubkrehel/make-interfaces-feel-better",
  "anthropics/frontend-design",
  "ibelick/baseline-ui",
  "shadcn-ui/shadcn",
  "addyosmani/web-quality-audit",
  "pbakaus/impeccable",
];
const skillByPath = new Map(skills.map((skill) => [skill.pathSlug, skill]));
const featuredSkills = footerSkillPaths
  .map((path) => skillByPath.get(path))
  .filter((skill): skill is NonNullable<typeof skill> => Boolean(skill));
const footerCollectionSlugs = [
  "mobile-app-design",
  "website-layout",
  "visual-hierarchy",
  "design-principles",
  "landing-page-design",
  "button-design",
  "form-design",
  "videos",
  "design-engineering",
  "web-development-best-practices",
  "design-system-guidelines",
  "dashboard-ui",
];
const collectionBySlug = new Map(
  collections.map((collection) => [collection.slug, collection]),
);
const footerCollections = footerCollectionSlugs
  .map((slug) => collectionBySlug.get(slug))
  .filter((collection): collection is NonNullable<typeof collection> =>
    Boolean(collection),
  );
type FooterLink = {
  label: string;
  href: string;
  external?: boolean;
};

type FooterSection = {
  title: string;
  links: FooterLink[];
};

const footerSections: FooterSection[] = [
  {
    title: "Browse",
    links: [
      { label: "Home", href: "/" },
      { label: "Skills", href: "/skills" },
      { label: "New skills", href: "/skills/new" },
      { label: "Authors", href: "/authors" },
      { label: "Icon", href: "/icons" },
      { label: "Components", href: "/components" },
      { label: "Collections", href: "/collections" },
      { label: "Design.md", href: "/design-md" },
      { label: "Agents", href: "/agents" },
      { label: "Jobs", href: "/jobs" },
      { label: "MCP", href: "/mcp/docs" },
      { label: "CLI", href: "/cli" },
      { label: "Registry", href: "/skills/registry.txt" },
      { label: "llms.txt", href: "/llms.txt" },
    ],
  },
  {
    title: "Topics",
    links: [
      ...featuredTopics.map((topic) => ({
        label: topic.label,
        href: `/skills/${topic.slug}`,
      })),
      { label: "All topics", href: "/skills/topics" },
    ],
  },
  {
    title: "Collections",
    links: [
      ...footerCollections.map((collection) => ({
        label: collection.title,
        href: `/collections/${collection.slug}`,
      })),
      { label: "All collections", href: "/collections" },
    ],
  },
  {
    title: "Agents",
    links: [
      ...featuredAgents.map((agent) => ({
        label: agent.name,
        href: `/agents/${agent.id}`,
      })),
      { label: "More agents", href: "/agents" },
    ],
  },
  {
    title: "Best skills",
    links: [
      ...featuredSkills.map((skill) => ({
        label: skill.label,
        href: `/skills/${skill.pathSlug}`,
      })),
      { label: "All skills", href: "/skills" },
    ],
  },
  {
    title: "Learn",
    links: [
      ...featuredPlaybook.map((entry) => ({
        label: entry.title,
        href: `/playbook/${entry.slug}`,
      })),
      { label: "More playbook", href: "/playbook" },
    ],
  },
];
---

<footer class="border-line-default mt-32 border-t">
  <div class="pt-20 pb-5">
    <div class="container-7xl">
      <div class="type-body-md grid gap-10 md:grid-cols-2 lg:grid-cols-6">
        {
          footerSections.map((section) => (
            <div>
              <h3 class="type-body-md text-content-secondary leading-snug font-[450]">
                {section.title}
              </h3>
              <ul class="mt-3 space-y-2 leading-snug">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                      title={link.label}
                      aria-label={link.label}
                      class="type-body-md text-content-secondary hover:text-content-primary block max-w-full truncate font-normal"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div
        class="type-body-md border-line-default text-content-secondary mt-16 flex w-full justify-center border-t pt-16 leading-snug"
      >
        <p class="text-center">
          ©{currentYear}
          {" "}UI Skills
        </p>
      </div>
    </div>
  </div>
</footer>
